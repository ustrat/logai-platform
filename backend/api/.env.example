PORT=4000
NODE_ENV=development

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito — get from: aws cloudformation describe-stacks --stack-name valuepilot-cognito-production
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Secrets (development only) ───────────────────────────────────────────────
# In production these are loaded from AWS Secrets Manager automatically.
# In development (NODE_ENV != production) these env vars are used as fallback.

# JWT — keep short in all environments; production minimum is 30m
JWT_SECRET=change_this_to_a_strong_random_value_in_dev
JWT_EXPIRES_IN=30m

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (Gmail email intelligence)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/email-intel/connect/gmail/callback

# SMTP (invoice emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Other services
ML_SERVICE_URL=http://localhost:8000
APP_URL=http://localhost:3000

# AWS Secrets Manager prefix (production) — default: valuepilot
# SECRETS_PREFIX=valuepilot
