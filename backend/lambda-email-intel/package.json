{
  "name": "valuepilot-email-intel-lambda",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build":   "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/handler.js --external:@aws-sdk/* --minify",
    "package": "npm run build && cd dist && zip -r ../function.zip handler.js",
    "deploy":  "npm run build && sam deploy --config-file samconfig.toml",
    "invoke":  "sam local invoke EmailIntelScanFunction --event events/scheduled.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3":              "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-sns":             "^3.0.0",
    "googleapis":                      "^140.0.0",
    "imapflow":                        "^1.0.0",
    "mailparser":                      "^3.0.0",
    "natural":                         "^6.0.0",
    "node-fetch":                      "^3.0.0",
    "isomorphic-fetch":                "^3.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda":    "^8.10.0",
    "@types/mailparser":    "^3.4.0",
    "@types/node":          "^20.0.0",
    "esbuild":              "^0.20.0",
    "typescript":           "^5.0.0"
  }
}
