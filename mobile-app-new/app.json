        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1e3a5f",
          "sounds": []
        }
      ]
    ],
    "scheme": "valuepilot",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56a8bfa0-ccc4-4470-9118-a9bffa81da76"
