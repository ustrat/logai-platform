    "orientation": "default",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f0f4f8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valuepilot.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.valuepilot.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
